{
  "manifest_version": 3,
  "name": "Duplicate Tab Closer",
  "version": "1.0.0",
  "description": "Find and close duplicate tabs across your Chrome windows. Local processing, no accounts or data sent to us.",
  "permissions": ["tabs"],
  "incognito": "not_allowed",
  "action": {"default_popup": "popup.html", "default_title": "Duplicate Tab Closer", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'"}
}
